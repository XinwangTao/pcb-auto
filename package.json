    "name": "陶鑫旺",
    "url": "https://github.com/XinwangTao"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node test/syntax-gate.mjs && node test/dev-path-scan.mjs && node test/doc-refs.mjs && node test/doc-anchors.mjs && node test/placement-rules.mjs && node test/acoustic-voids-gate.mjs && node test/log-timeline-gate.mjs && node test/relayout-formfactor-gate.mjs && node test/capability-gate.mjs && node test/fabcheck-selftest.mjs && node test/via-restore-accounting.mjs && node test/epvia-size-gate.mjs && node test/stitch-crossnet-accounting.mjs && node test/runall-fabcheck-on-fail.mjs && node test/smoke.mjs && node test/plugin-harness.mjs && node test/mutants.mjs",
    "mutants": "node test/mutants.mjs",
    "doc-anchors": "node test/doc-anchors.mjs",
    "fabcheck-selftest": "node test/fabcheck-selftest.mjs",
    "via-restore": "node test/via-restore-accounting.mjs",
    "epvia-size-gate": "node test/epvia-size-gate.mjs",
    "stitch-crossnet": "node test/stitch-crossnet-accounting.mjs",
    "runall-fabcheck": "node test/runall-fabcheck-on-fail.mjs",
    "pcb": "node cli/pcb.mjs",
    "mcp": "node mcp/server.mjs",
    "install-clients": "node install/install.mjs",
    "fabcheck": "node scripts/fabcheck.js",
    "verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File verify-delivery.ps1"
  },
  "bin": {
    "pcb": "cli/pcb.mjs"
  },
  "files": [
    "core",
    "cli",
    "mcp",
    "plugin",
    "install",
    "scripts",
    "designs",
    "examples",
    "docs",
    "api",
    "test",
    "capabilities.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "llms.txt",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "CITATION.cff"
  ],
  "devDependencies": {
    "acorn": "^8.19.0",
    "eslint-scope": "^5.1.1"
  }
}
