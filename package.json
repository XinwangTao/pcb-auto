{
  "name": "pcb-auto",
  "version": "1.0.0",
  "description": "Natural-language (Chinese) idea → orderable PCB, unattended. A measurement-first harness: 5 tools, 4 independent acceptance layers, and a published failure rate you can recompute.",
  "keywords": [
    "pcb",
    "eda",
    "gerber",
    "ecad",
    "ai-eda",
    "llm-eda",
    "natural-language-to-pcb",
    "text-to-pcb",
    "automatic-pcb-layout",
    "autorouter",
    "drc",
    "dfm",
    "bom",
    "pick-and-place",
    "lceda",
    "easyeda",
    "kicad",
    "pcb-design-automation",
    "ai-agent",
    "dsh-plugin",
    "cordis-plugin",
    "mcp",
    "chinese",
    "中文",
    "硬件自动化"
  ],
  "homepage": "https://github.com/XinwangTao/pcb-auto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XinwangTao/pcb-auto.git"
  },
  "bugs": {
    "url": "https://github.com/XinwangTao/pcb-auto/issues"
  },
  "license": "MIT",
